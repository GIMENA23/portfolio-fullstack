# Copiar este archivo como .env (no se sube a GitHub)

PORT=4000

# MongoDB Atlas → Connect → Drivers → copiar la cadena y reemplazar <password>
# Agregar el nombre de la base antes del "?":  ...mongodb.net/portfolio?retryWrites=true...
MONGODB_URI=

# Cualquier texto largo y secreto (todos usan el mismo en desarrollo)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# URL del frontend (en producción, la de Vercel). Varias separadas por coma.
CLIENT_URL=http://localhost:5173

# Google Cloud Console → Credenciales → ID de cliente OAuth (opcional al principio)
GOOGLE_CLIENT_ID=

# Gmail del proyecto + contraseña de aplicación (opcional al principio:
# sin esto, los emails se muestran en la consola en lugar de enviarse)
MAIL_USER=
MAIL_PASS=
MAIL_TO=
