# Copiá este archivo a .env y completalo. El .env nunca se sube al repositorio.
# En Render estas mismas variables se cargan en el panel (Environment): ver DEPLOY.md.

# --- Obligatorias -------------------------------------------------------------------------------

# Cadena de conexión de MongoDB Atlas (o mongodb://localhost:27017/portfolio si tenés Mongo instalado)
MONGODB_URI=

# Clave para firmar los tokens. En producción tiene que tener al menos 32 caracteres. Generá una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Cliente y servidor -------------------------------------------------------------------------

# URL del cliente. Se usa para CORS y para los enlaces de los emails. Admite varias separadas por coma, sin barra
# final y sin ruta. La PRIMERA es la que va en los emails (no puede llevar *). Un * reemplaza una parte del nombre,
# útil para las previsualizaciones de Vercel:
#   CLIENT_URL=https://mi-app.vercel.app,https://mi-app-*-miequipo.vercel.app
CLIENT_URL=http://localhost:5173

# Puerto de la API (Render lo define solo). Por defecto 4000.
PORT=4000

# Cuántos proxies hay delante del servidor. En Render, 1. Si los límites de intentos se comparten entre todos
# los visitantes, probá con 2 (ver DEPLOY.md). En local no hace falta tocarlo.
TRUST_PROXY=1

# Duración de la sesión (opcional). Por defecto 7d.
JWT_EXPIRES_IN=7d

# --- Login con Google ---------------------------------------------------------------------------

# Client ID de Google Cloud Console. Sin esto, /api/auth/google responde 503.
GOOGLE_CLIENT_ID=

# --- Emails (Nodemailer) ------------------------------------------------------------------------
# Sin MAIL_USER y MAIL_PASS los emails no se envían: se muestran en la consola.
#
# Opción A, para desarrollo en tu PC: Gmail con contraseña de aplicación.
#   MAIL_USER=tu-cuenta@gmail.com   MAIL_PASS=<contraseña de aplicación de 16 caracteres>
#   (dejá MAIL_HOST, MAIL_PORT y MAIL_FROM vacíos)
#
# Opción B, para Render gratis: Render BLOQUEA los puertos 25, 465 y 587, así que Gmail no funciona allá.
# Usá un servicio SMTP que ofrezca el puerto 2525 (por ejemplo Brevo, ver DEPLOY.md):
#   MAIL_HOST=<servidor SMTP del servicio>   MAIL_PORT=2525
#   MAIL_USER=<usuario SMTP>                 MAIL_PASS=<clave SMTP>
#   MAIL_FROM=<email remitente verificado en el servicio>
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# --- Archivos (Cloudinary) ----------------------------------------------------------------------
# Imágenes de proyectos, foto del perfil y adjuntos de contacto. Alcanza con CLOUDINARY_URL
# (cloudinary://API_KEY:API_SECRET@CLOUD_NAME, lo da el panel de Cloudinary) o con las tres variables sueltas.
# Sin esto, POST /api/uploads responde 503.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Datos de prueba ----------------------------------------------------------------------------

# Contraseña de las cuentas de prueba que crea `npm run seed` (admin, operador y usuario @portfolio.test).
# En una base que no es local (Atlas) es obligatoria y de al menos 10 caracteres. En local, si falta, se usa Portfolio2026.
SEED_PASSWORD=
